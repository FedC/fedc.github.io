{
  "name": "shaders-on-scroll",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "start": "parcel src/index.html --open",
    "clean": "rm -rf dist",
    "build:parcel": "parcel build src/index.html --no-source-maps --public-url ./",
    "build": "npm run clean && npm run build:parcel",
    "prepare-publish": "node scripts/prepare-publish.mjs",
    "build:publish": "npm run build && npm run prepare-publish",
    "copy-dist-to-root": "echo \"DEPRECATED: use GitHub Actions Pages deploy (npm run build:publish). Root copy kept only for emergency rollback.\" && cp -r dist/* ../"
  },

  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@parcel/packager-raw-url": "2.16.4",
    "@parcel/transformer-glsl": "2.16.4",
    "@parcel/transformer-jsonld": "2.16.4",
    "@parcel/transformer-sass": "2.16.4",
    "parcel": "2.16.4"
  },
  "dependencies": {
    "animejs": "^3.2.2",
    "gsap": "^3.7.0",
    "three": "^0.129.0"
  },
  "overrides": {
    "base-x": "3.0.11"
  }
}
